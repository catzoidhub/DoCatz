{
  "name": "docatz",
  "productName": "DoCatz",
  "version": "1.0.1",
  "license": "GPL-3.0-only",
  "private": true,
  "description": "DoCatz — a fast, light Docker engine and container manager: a small Linux VM, containers grouped by compose project, logs, terminal and files, every container on its own domain. Part of the Catzoid family.",
  "main": "./out/main/index.js",
  "repository": "github:catzoidhub/DoCatz",
  "scripts": {
    "predev": "node scripts/dev-bundle-name.mjs",
    "dev": "electron-vite dev",
    "build": "node scripts/licenses.mjs && electron-vite build",
    "licenses": "node scripts/licenses.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "quick": "node scripts/quick.mjs",
    "package": "node scripts/package.mjs",
    "package:dir": "electron-vite build && electron-builder --mac dir",
    "icons": "bun scripts/render-icons.ts",
    "postinstall": "node node_modules/electron/install.js || bun node_modules/electron/install.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22",
    "@types/node-forge": "^1.3.14",
    "@vitejs/plugin-vue": "^6.0.10",
    "daisyui": "^5.7.50",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "trustedDependencies": [
    "electron"
  ],
  "author": {
    "name": "Mahryan Rakhmatullah"
  }
}
